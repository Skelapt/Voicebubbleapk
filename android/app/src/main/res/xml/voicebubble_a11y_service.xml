<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration for VoiceBubbleA11yService.

    DELIBERATELY NARROW SCOPE. Google Play's Accessibility API policy
    says: "Apps must use limited, more narrowly scoped APIs and
    permissions in lieu of the Accessibility API when possible to
    achieve the desired functionality." We comply by requesting only
    the events the service code actually consumes:

      - typeViewFocused:        used to track which app's editable
                                field has focus, so the Insert action
                                knows where to put the text.
      - typeWindowStateChanged: used to track which app is currently
                                in the foreground.

    We do NOT request:
      - typeViewTextSelectionChanged
      - typeWindowContentChanged
      - typeViewTextChanged
      - typeNotificationStateChanged
      - …or any other event class.

    Flags are limited to flagDefault. We do NOT request
    flagRetrieveInteractiveWindows or flagRequestFilterKeyEvents
    because the code does not need them.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.voicebubble.app.MainActivity"
    android:summary="@string/a11y_service_summary"
    android:description="@string/a11y_service_description" />
